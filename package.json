  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.85.1",
    "@opencode-ai/plugin": "^1.4.7",
    "@opentui/solid": "0.5.11",
    "@opentui/core": "0.5.11",
    "solid-js": "1.9.12"
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "files": [
